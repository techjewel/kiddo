{
  "name": "kiddo-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kiddo on Vue 3 + TypeScript + Vite. Phase 0: the legacy app built through this pipeline. Not deployed.",
  "scripts": {
    "sync": "node scripts/sync-legacy.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "workbox-precaching": "^7.4.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
