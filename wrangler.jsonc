{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abcd-learning",
  "account_id": "4b5c678d39713cad840c2983dbce27e1",
  "compatibility_date": "2026-08-19",
  // The site is the Vite build in dist/, not the repo root. Wrangler
  // runs this before every deploy and every preview upload, on
  // Cloudflare's Workers Builds too, so dist/ is never stale or missing.
  "build": {
    "command": "npm ci --prefix app && npm --prefix app run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // A missing file is a 404, never the app. With the single-page
    // fallback a missing sound came back as index.html with a 200, and
    // the service worker filed it as that sound for good.
    "not_found_handling": "404-page"
  },
  // The apex is the address on the card and in the og: tags. A custom
  // domain needs kiddo.page to be a zone on this account; Cloudflare
  // makes the DNS record and the certificate itself.
  "routes": [
    { "pattern": "kiddo.page", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
